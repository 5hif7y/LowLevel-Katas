 int
 master_main(char **argv, int waitattach, int dontfork)
 {
 	int fd[2] = {-1, -1};
 	int s;
 	pid_t pid;
+#ifdef _WIN32
+	int statusfd = -1;
+#endif
 
 	/* Use a default redraw method if one hasn't been specified yet. */
 	if (redraw_method == REDRAW_UNSPEC)
+#ifdef _WIN32
+		/* ConPTY repaints the whole screen on a resize: "winch" is a
+		** real redraw here, while ^L would be typed into cmd.exe. */
+		redraw_method = REDRAW_WINCH;
+#else
 		redraw_method = REDRAW_CTRL_L;
+#endif
+
+#ifdef _WIN32
+	if (!compat_daemon_role() && !dontfork)
+		return win32_spawn_master();
+	if (compat_daemon_role())
+	{
+		/* Errors printed from here on travel to the waiting client. */
+		statusfd = compat_daemon_statusfd();
+		if (statusfd >= 0)
+			dup2(statusfd, 1);
+	}
+#endif
 
 	/* Create the unix domain socket. */
 	s = create_socket(sockname);
@@ -611,6 +700,14 @@ master_main(char **argv, int waitattach, int dontfork)
 		return 1;
 	}
 
+#ifdef _WIN32
+	if (compat_daemon_role())
+	{
+		master_process(s, argv, waitattach, statusfd);
+		return 0;
+	}
+#endif
+
 #if defined(F_SETFD) && defined(FD_CLOEXEC)
 	fcntl(s, F_SETFD, FD_CLOEXEC);
 
