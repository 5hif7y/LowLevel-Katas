+#ifdef _WIN32
+/*
+** WIN32 replacement for the fork() below. The client re-executes its own
+** binary, detached from the console, with the same argv; the new process
+** sees compat_daemon_role() and becomes the master. The inherited status
+** pipe plays the role of the FD_CLOEXEC pipe: error text, or EOF once the
+** socket exists and the program is running.
+*/
+static int
+win32_spawn_master(void)
+{
+	char buf[1024];
+	ssize_t len;
+	int st;
+	pid_t pid;
+
+	pid = compat_spawn_self_detached("dtach-master",
+		(const char *const *)win32_argv, &st);
+	if (pid < 0)
+	{
+		printf("%s: spawn: %s\n", progname, strerror(errno));
+		return 1;
+	}
+	len = read(st, buf, sizeof(buf));
+	if (len > 0)
+	{
+		do
+		{
+			write_buf_or_fail(2, buf, len);
+			len = read(st, buf, sizeof(buf));
+		} while (len > 0);
+		kill(pid, SIGTERM);
+		close(st);
+		return 1;
+	}
+	close(st);
+	return 0;
+}
+#endif
