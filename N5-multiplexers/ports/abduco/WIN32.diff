+/* WIN32 server side: run in the process that create_session() spawned. */
+static void win32_server_main(const char *name, char * const argv[]) {
+	char errormsg[255];
+	int statusfd = compat_daemon_statusfd();
+	const char *ws = getenv("ABDUCO_WIN32_WINSIZE");
+	unsigned rows = 0, cols = 0;
+	if (ws && sscanf(ws, "%ux%u", &cols, &rows) == 2) {
+		server.winsize.ws_col = cols;
+		server.winsize.ws_row = rows;
+	}
+	unsetenv("ABDUCO_WIN32_WINSIZE");
+
+	if ((server.socket = server_create_socket(name)) == -1) {
+		snprintf(errormsg, sizeof(errormsg), "server-socket: %s\n", strerror(errno));
+		write_all(statusfd, errormsg, strlen(errormsg));
+		_exit(EXIT_FAILURE);
+	}
+	struct sigaction sa;
+	sa.sa_flags = 0;
+	sigemptyset(&sa.sa_mask);
+	sa.sa_handler = server_pty_died_handler;
+	sigaction(SIGCHLD, &sa, NULL);
+
+	struct compat_spawn_opts o;
+	memset(&o, 0, sizeof(o));
+	o.argv = (const char *const *)argv;
+	o.ws = server.winsize;
+	o.stdin_fd = o.stdout_fd = -1;
+	if ((server.pid = compat_spawn_pty(&o, &server.pty)) == -1) {
+		snprintf(errormsg, sizeof(errormsg), "server-execvp: %s: %s\n",
+		         argv[0], strerror(errno));
+		write_all(statusfd, errormsg, strlen(errormsg));
+		unlink(sockaddr.sun_path);
+		_exit(EXIT_FAILURE);
+	}
+	sa.sa_handler = server_sigterm_handler;
+	sigaction(SIGTERM, &sa, NULL);
+	sigaction(SIGINT, &sa, NULL);
+	sa.sa_handler = SIG_IGN;
+	sigaction(SIGPIPE, &sa, NULL);
+	sigaction(SIGHUP, &sa, NULL);
+	close(statusfd); /* EOF = success for the waiting client */
+	server_mainloop();
+}
+
+/* WIN32 client side: replaces the fork()/setsid()/fork()/forkpty() dance. */
+static bool create_session(const char *name, char * const argv[]) {
+	char errormsg[255], ws[32];
+	int status_rd;
+	(void)argv;
+	if (session_exists(name)) {
+		errno = EADDRINUSE;
+		return false;
+	}
+	snprintf(ws, sizeof ws, "%ux%u", server.winsize.ws_col, server.winsize.ws_row);
+	setenv("ABDUCO_WIN32_WINSIZE", ws, 1);
+	pid_t pid = compat_spawn_self_detached("abduco-server",
+	                                       (const char *const *)win32_argv, &status_rd);
+	unsetenv("ABDUCO_WIN32_WINSIZE");
+	if (pid == -1)
+		return false;
+	ssize_t len = read_all(status_rd, errormsg, sizeof(errormsg));
+	close(status_rd);
+	if (len > 0) {
+		write_all(STDERR_FILENO, errormsg, len);
+		exit(EXIT_FAILURE);
+	}
+	return true;
+}
